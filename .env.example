# API 서버 환경변수. 이 파일을 .env로 복사해 사용한다. .env는 커밋되지 않는다.
# Mock 모드는 아무 값도 설정하지 않아도 동작한다. 값을 비워 두면 설정하지 않은 것으로 본다.

APP_ENV=development
# 허용할 프론트엔드 주소(쉼표로 구분). 와일드카드를 쓰지 않는다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VALUATION_CURRENCY=KRW

# --- Supabase (Phase 3) ---
# 로그인 토큰은 {SUPABASE_URL}/auth/v1/.well-known/jwks.json의 공개 키로 검증한다. JWT secret은 쓰지 않는다.
SUPABASE_URL=
# 공개용 키. 서버는 쓰지 않으며 통합 테스트(실제 Auth 확인)에만 쓴다.
SUPABASE_PUBLISHABLE_KEY=
# Connect → Session pooler 연결 문자열. 비밀번호가 들어 있으므로 서버에만 둔다.
DATABASE_URL=
# DB 통합 테스트(pytest -m integration)에서 RLS를 확인할 실제 사용자 UID. 앱은 쓰지 않는다.
LIVE_OWNER_USER_ID=

# --- 한국투자증권 (서버 전용, 조회만) ---
# 사용자마다 설정 화면에서 본인 App Key·Secret·계좌번호를 등록한다. 서버는 이 키로 암호화(AES-256-GCM)해
# DB(public.kis_credentials)에 저장한다. 32바이트 키를 base64로 넣는다. 만드는 법:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 키를 바꾸거나 잃어버리면 저장된 KIS 키를 읽을 수 없어 모든 사용자가 다시 등록해야 한다. 따로 백업해 둔다.
KIS_CREDENTIAL_KEY=

# --- OpenAI (Phase 5, 서버 전용) ---
# OPENAI_API_KEY=

# 프론트엔드 변수는 apps/web/.env.local에 둔다(apps/web/.env.example 참고).
# NEXT_PUBLIC_ 값은 브라우저에 노출되므로 공개 가능한 값만 넣는다.
