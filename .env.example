# API 서버 환경변수. 이 파일을 .env로 복사해 사용한다. .env는 커밋되지 않는다.
# Mock 모드는 아무 값도 설정하지 않아도 동작한다.

APP_ENV=development
# 허용할 프론트엔드 주소(쉼표로 구분). 와일드카드를 쓰지 않는다.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VALUATION_CURRENCY=KRW

# --- Phase 3: Supabase (서버 전용) ---
# SUPABASE_URL=
# SUPABASE_JWT_SECRET=
# LIVE 데이터를 볼 수 있는 유일한 Supabase 사용자 id. 비어 있으면 LIVE 접근은 모두 거부된다.
# LIVE_OWNER_USER_ID=

# --- Phase 4: 한국투자증권 (서버 전용) ---
# KIS_APP_KEY=
# KIS_APP_SECRET=
# 형식: 계좌 8자리-상품코드 2자리
# KIS_ACCOUNT_NO=

# --- Phase 5: OpenAI (서버 전용) ---
# OPENAI_API_KEY=

# 프론트엔드 변수는 apps/web/.env.local에 둔다. NEXT_PUBLIC_ 값은 브라우저에 노출되므로
# 비밀 값을 넣지 않는다.
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
